# Copia este archivo a .env y completa tus valores (no se versiona).
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Opcional: webhook del chat de n8n
# VITE_N8N_WEBHOOK_URL=https://tu-instancia.app.n8n.cloud/webhook/<id>/chat

# Opcional: punto de partida por defecto para las rutas (Bogotá)
# VITE_DEPOT_LAT=4.7110
# VITE_DEPOT_LNG=-74.0721

# Pon VITE_DEMO_MODE=true para correr sin Supabase (datos simulados en el navegador)
# VITE_DEMO_MODE=true
